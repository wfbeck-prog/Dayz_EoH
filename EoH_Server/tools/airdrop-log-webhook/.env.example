# Discord webhook for #airdrop-tracking
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE/REPLACE

# HostHavoc profile Expansion logs folder.
# Based on your screenshot this should point at ExpansionMod\Logs.
LOG_DIR=C:\Path\To\HostHavocDayZServer\ExpansionMod\Logs

# Optional: also send high-value drops to radio webhook.
RADIO_WEBHOOK_URL=

# Poll interval in milliseconds.
POLL_INTERVAL_MS=5000

# Remember lines already sent between restarts.
STATE_FILE=./airdrop-log-state.json
