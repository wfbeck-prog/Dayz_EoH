    <Options><MapRender pos="3040.058350, 7837.127441" zoom="0.25" showPoints="always" showMarker="always" allowInteraction="1" /><SafeRadius zombie="15" animal="0" player="100" other="0" /></Options>
    <Points><Point pos="3310.058350, 7567.127441" /></Points>
    <Conditions><EoHOwnedTown town="Pustoshka" /></Conditions>
</Respawn>

